<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- ============ 视频层：铺满全屏 ============ -->
    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:descendantFocusability="blocksDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- ExoPlayer 画面真正挂载在这里 -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF000000"
            app:resize_mode="zoom"
            app:shutter_background_color="#FF000000"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <!-- 顶部信息（避开左侧悬浮面板，整体右移） -->
        <LinearLayout
            android:id="@+id/info_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="372dp"
            android:background="@drawable/bg_top_gradient"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="24dp"
            android:paddingEnd="30dp"
            android:paddingBottom="44dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_live_chip"
                    android:letterSpacing="0.06"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="● LIVE"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_now_playing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_episode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 底部信息（同样右移） -->
        <LinearLayout
            android:id="@+id/info_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="372dp"
            android:background="@drawable/bg_bottom_gradient"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="44dp"
            android:paddingEnd="30dp"
            android:paddingBottom="22dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:background="@drawable/bg_progress_track">

                <View
                    android:id="@+id/header_progress"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:background="@drawable/bg_progress_fill" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="菜单键刷新"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_schedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 加载遮罩 -->
        <LinearLayout
            android:id="@+id/loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC000000"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:indeterminateTint="@color/live_red" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="正在缓冲直播流…"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ============ 左侧悬浮节目单（漂浮在视频之上） ============ -->
    <LinearLayout
        android:id="@+id/guide_panel"
        android:layout_width="@dimen/guide_width"
        android:layout_height="match_parent"
        android:layout_gravity="left|fill_vertical"
        android:layout_marginStart="@dimen/guide_margin"
        android:layout_marginTop="@dimen/guide_margin"
        android:layout_marginBottom="@dimen/guide_margin"
        android:background="@drawable/bg_guide_panel"
        android:elevation="28dp"
        android:orientation="vertical">

        <!-- 头部 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="@color/live_red" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:text="怀旧剧场"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_info"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_btn"
                    android:contentDescription="信息"
                    android:scaleType="centerInside"
                    android:tint="@color/text_primary"
                    android:src="@drawable/ic_info" />

                <ImageButton
                    android:id="@+id/btn_reload"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_icon_btn"
                    android:contentDescription="刷新"
                    android:scaleType="centerInside"
                    android:tint="@color/text_primary"
                    android:src="@drawable/ic_refresh" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="正在获取节目单…"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channel_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:paddingTop="10dp"
            android:paddingBottom="16dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>
